{
  "intents": {
    "volume_up": {
      "keywords": ["ses", "sesi", "yükselt", "artır", "açar"],
      "patterns": ["ses(i)?.*(yükselt|artır|aç)", "(yükselt|artır).*ses"],
      "action": "volume_up",
      "description": "Sesi yükselt"
    },
    "volume_down": {
      "keywords": ["ses", "sesi", "azalt", "düşür", "indir"],
      "patterns": ["ses(i)?.*(azalt|düşür|indir)", "(azalt|düşür).*ses"],
      "action": "volume_down",
      "description": "Sesi azalt"
    },
    "mute": {
      "keywords": ["sessize", "sessiz", "sustur", "kapat"],
      "patterns": ["sessize.*al", "sessiz.*yap", "sesi.*kapat"],
      "action": "mute",
      "description": "Sessize al"
    },
    "unmute": {
      "keywords": ["sessizden", "sessizlik", "çık", "aç"],
      "patterns": ["sessiz(den|lik).*(çık|kaldır)", "sesi.*aç"],
      "action": "unmute",
      "description": "Sessizden çık"
    },
    "brightness_up": {
      "keywords": ["parlaklık", "parlaklığı", "ekran", "artır", "yükselt"],
      "patterns": ["parlaklı(k|ğı).*(artır|yükselt)", "ekran.*(parlat|aydınlat)"],
      "action": "brightness_up",
      "description": "Parlaklığı artır"
    },
    "brightness_down": {
      "keywords": ["parlaklık", "parlaklığı", "ekran", "azalt", "düşür", "karart"],
      "patterns": ["parlaklı(k|ğı).*(azalt|düşür|karart)", "ekran.*(karart|azalt)"],
      "action": "brightness_down",
      "description": "Parlaklığı azalt"
    },
    "wifi_on": {
      "keywords": ["wifi", "wi-fi", "internet", "aç", "bağlan"],
      "patterns": ["wifi.*aç", "wi-fi.*aç", "interneti.*aç", "wifi.*bağlan"],
      "action": "wifi_on",
      "description": "WiFi'yi aç"
    },
    "wifi_off": {
      "keywords": ["wifi", "wi-fi", "internet", "kapat", "kapa", "kes"],
      "patterns": ["wifi.*kapat", "wi-fi.*kapat", "interneti.*kapat", "wifi.*kes"],
      "action": "wifi_off",
      "description": "WiFi'yi kapat"
    },
    "bluetooth_on": {
      "keywords": ["bluetooth", "bluetoothu", "aç", "bağlan"],
      "patterns": ["bluetooth.*aç", "bluetoothu.*aç", "bluetooth.*bağlan"],
      "action": "bluetooth_on",
      "description": "Bluetooth'u aç"
    },
    "bluetooth_off": {
      "keywords": ["bluetooth", "bluetoothu", "kapat", "kapa", "kes"],
      "patterns": ["bluetooth.*kapat", "bluetoothu.*kapat", "bluetooth.*kes"],
      "action": "bluetooth_off",
      "description": "Bluetooth'u kapat"
    },
    "open_settings": {
      "keywords": ["ayarlar", "ayarları", "sistem", "tercihler", "aç"],
      "patterns": ["ayarla(r|rı).*aç", "sistem.*ayar.*aç", "tercih.*aç"],
      "action": "open_settings",
      "description": "Ayarları aç"
    },
    "open_browser": {
      "keywords": ["tarayıcı", "tarayıcıyı", "chrome", "safari", "firefox", "internet", "aç"],
      "patterns": ["tarayıcı(yı)?.*aç", "(chrome|safari|firefox).*aç", "internet.*aç"],
      "action": "open_browser",
      "description": "Tarayıcıyı aç"
    },
    "open_file_explorer": {
      "keywords": ["dosya", "gezgin", "finder", "klasör", "aç"],
      "patterns": ["dosya.*gezgin.*aç", "finder.*aç", "dosya.*yönetici.*aç"],
      "action": "open_file_explorer",
      "description": "Dosya gezginini aç"
    },
    "screenshot": {
      "keywords": ["ekran", "görüntü", "screenshot", "ss", "al", "çek"],
      "patterns": ["ekran.*görüntü.*al", "screenshot.*al", "ekran.*çek"],
      "action": "take_screenshot",
      "description": "Ekran görüntüsü al"
    },
    "get_time": {
      "keywords": ["saat", "kaç", "zaman"],
      "patterns": ["saat.*kaç", "kaç.*saat", "zaman.*söyle", "saati.*söyle"],
      "action": "get_time",
      "description": "Saati söyle"
    },
    "get_date": {
      "keywords": ["tarih", "bugün", "gün"],
      "patterns": ["tarih.*kaç", "bugün.*kaç", "kaç.*tarih", "tarihi.*söyle"],
      "action": "get_date",
      "description": "Tarihi söyle"
    },
    "get_battery": {
      "keywords": ["pil", "batarya", "şarj", "kaç"],
      "patterns": ["pil.*kaç", "pil.*seviye", "batarya.*kaç", "şarj.*kaç"],
      "action": "get_battery",
      "description": "Pil seviyesini söyle"
    },
    "play_music": {
      "keywords": ["müzik", "çal", "oynat", "başlat"],
      "patterns": ["müzik.*çal", "müzik.*oynat", "çal.*müzik"],
      "action": "play_music",
      "description": "Müzik çal"
    },
    "pause_music": {
      "keywords": ["müzik", "durdur", "pause", "duraklat"],
      "patterns": ["müzik.*durdur", "duraklat", "pause.*yap"],
      "action": "pause_music",
      "description": "Müziği duraklat"
    },
    "next_track": {
      "keywords": ["sonraki", "şarkı", "next", "geç"],
      "patterns": ["sonraki.*şarkı", "şarkı.*geç", "next.*track"],
